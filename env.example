# Vorlage für ~/fotos/.env auf dem Server (niemals committen).

# Adresse der Immich-Verwaltung, z.B. immich.floorba11.stream (DNS-A-Eintrag auf den Server, "DNS only").
# Die öffentliche Foto-Seite für die Spieler ist ein eigenes Projekt (fotos-web) auf einer anderen Adresse.
IMMICH_DOMAIN=

# Uploads, Vorschaubilder, Videos – lokale Disk (die Originale liegen auf der Storage Box unter /mnt/fotos)
UPLOAD_LOCATION=./library
# Datenbank – muss lokal liegen, kein Netzlaufwerk
DB_DATA_LOCATION=./postgres

TZ=Europe/Zurich
# Version festhalten; vor einem Update die Release Notes lesen: https://github.com/immich-app/immich/releases
IMMICH_VERSION=v3

# Nur A-Z, a-z, 0-9 (z.B. openssl rand -hex 24)
DB_PASSWORD=
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Gesichtserkennung schonend für einen kleinen Server: ein Worker, ein Thread, Modell nach 5 Minuten Leerlauf entladen
MACHINE_LEARNING_WORKERS=1
MACHINE_LEARNING_REQUEST_THREADS=1
MACHINE_LEARNING_MODEL_TTL=300

# Automatische Alben pro Ordner: Immich → Kontoeinstellungen → API-Schlüssel → neuen Schlüssel erstellen (nur hier eintragen)
IMMICH_API_KEY=
# Abstand in Sekunden zwischen den Läufen
ALBUM_SYNC_INTERVAL=900
